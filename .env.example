# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.

# ---------------------------------------------------------------------------
# Ordem dos provedores de LLM. O roteador tenta da esquerda para a direita e
# desce para o próximo assim que um falha. Depois do último, o agente ainda
# responde de forma extrativa, sem LLM.
# ---------------------------------------------------------------------------
# Para ativar a OCI, acrescente "oci" no começo da lista E instale o SDK:
#     pip install -r requirements-oci.txt
PROVEDORES_LLM=groq,gemini

# ---------------------------------------------------------------------------
# OCI Generative AI (provedor principal)
# ---------------------------------------------------------------------------
# OCID do compartimento onde o serviço está habilitado.
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Região com Generative AI disponível (ex.: sa-saopaulo-1, us-chicago-1).
OCI_REGION=sa-saopaulo-1

# Modelo on-demand. Confira os disponíveis no console da OCI.
OCI_GENAI_MODEL_ID=meta.llama-3.3-70b-instruct

# GENERIC para modelos Llama/Grok, COHERE para a família Command.
OCI_GENAI_API_FORMAT=GENERIC

# config           -> usa ~/.oci/config (desenvolvimento na sua máquina)
# instance_principal -> usa a identidade da VM (deploy dentro da OCI, sem chave no disco)
OCI_AUTH=config
OCI_CONFIG_PROFILE=DEFAULT

# ---------------------------------------------------------------------------
# Provedores de reserva (opcionais, mas recomendados para a demonstração)
# ---------------------------------------------------------------------------
# https://console.groq.com/keys
# Confira os modelos ativos da sua conta antes de fixar um aqui — a Groq
# descontinua modelos com frequência e a chamada devolve 404 quando isso acontece:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# https://aistudio.google.com/apikey
# O Google também aposenta modelos: se vier 404 dizendo "no longer available",
# a própria mensagem indica o substituto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ORIGENS_PERMITIDAS=*
